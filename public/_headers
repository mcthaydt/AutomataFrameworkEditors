# Cloudflare Pages applies these to the page's own files. `connect-src 'self'` is the rule that the page never talks
# to GitHub: it calls this site's own /api and nothing else. `Referrer-Policy: no-referrer` keeps the sign-in code
# from ever leaving in a Referer header.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
