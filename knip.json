{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": ["functions/**/*.ts", "src/index.ts", "tests/**/*.test.ts"],
  "project": ["src/**/*.{ts,svelte}", "functions/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": ["pixi.js"],
  "ignoreIssues": {
    "src/features/*/*.ts": ["types"]
  }
}
