{
  "name": "@automataframework/editors",
  "version": "0.0.0",
  "private": true,
  "description": "The editors for games made with AutomataFramework: a team changes its game's content by touch.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "knip": "knip",
    "build": "vite build",
    "build:journeys": "vite build --mode journeys",
    "build:journeys-plain": "VITE_DEMO_GAME= vite build --mode journeys --outDir dist-plain",
    "test:node": "vitest run --project node",
    "test:engine": "vitest run --passWithNoTests --project",
    "test:journeys": "vitest run --passWithNoTests --project journeys --bail=15 --reporter=default --reporter=json --outputFile.json=journeys-result.json"
  },
  "dependencies": {
    "@automataframework/framework": "github:mcthaydt/AutomataFramework#9109fa357193f57e2d12271c6e6b58dbd783b427",
    "pixi.js": "8.22.0",
    "smol-toml": "1.9.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@automataframework/framework@https://codeload.github.com/mcthaydt/AutomataFramework/tar.gz/9109fa357193f57e2d12271c6e6b58dbd783b427"
    ]
  }
}
